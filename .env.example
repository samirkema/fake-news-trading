# Connection string Supabase (Settings > Database > Connection string > URI, mode "Session")
# Pour le scraper/évaluateur (jobs GitHub Actions, courte durée) : connexion directe, port 5432.
DATABASE_URL=postgresql+psycopg2://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Pour le frontend hébergé sur Vercel (fonctions serverless, potentiellement concurrentes) :
# Supabase recommande la connexion via pooler (PgBouncer, port 6543, mode "Transaction")
# plutôt que la connexion directe, pour éviter d'épuiser les connexions Postgres du tier
# gratuit. À configurer séparément dans les variables d'environnement Vercel si besoin.

# App Reddit de type "script" (gratuit, à créer sur https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=[YOUR-CLIENT-ID]
REDDIT_CLIENT_SECRET=[YOUR-CLIENT-SECRET]
REDDIT_USER_AGENT=fakenews-scraper/0.1 (script personnel)

# Frontend (US-04) : mot de passe partagé pour la version hébergée (Vercel).
# Non définie = pas d'authentification (mode local/dev uniquement, cf. userstories_frontend.md).
FRONTEND_PASSWORD=[À définir uniquement en hébergé]

# LLM (US-07 évaluateur, US-02 contextualiseur) : Claude (Anthropic), cf. fakenews.llm.
# Clé sur https://console.anthropic.com/ — non définie = les deux signaux/génération
# dégradent proprement (exclus/aucune mise en contexte générée), pas de plantage.
ANTHROPIC_API_KEY=[YOUR-ANTHROPIC-API-KEY]
# Optionnel : modèle à utiliser (défaut : claude-haiku-4-5-20251001, cf. fakenews.llm).
LLM_MODELE=claude-haiku-4-5-20251001
# Optionnel : plafond d'appels LLM par run évaluateur (US-07, défaut 50).
LLM_PLAFOND_EVALUATEUR=50
